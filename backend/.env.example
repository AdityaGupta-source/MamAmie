NODE_ENV=development
PORT=4000
HOST=0.0.0.0
DATABASE_URL="file:./dev.db"
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars
# Comma-separated origins allowed by CORS. Native apps don't need CORS; this is for Expo web.
CORS_ORIGINS=http://localhost:8081
# Optional: Gemini API key for Phase 6 (Food Analyze) & Phase 7 (Ask Chat). Leave blank for rule-based fallback.
GEMINI_API_KEY=
UPLOAD_DIR=./uploads
MAX_FILE_BYTES=10485760
